{
  "name": "koishi-plugin-aka-ai-image-generator",
  "version": "0.8.13",
  "description": "AI image generator for Koishi (V2: semantic supplier UI, image protocols, credit billing).",
  "license": "MIT",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "files": [
    "dist",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.11",
    "koishi": "^4.18.9"
  },
  "dependencies": {
    "@koishijs/console": "^5.30.11",
    "jimp": "^0.22.10"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@types/node": "^24.5.2",
    "koishi": "^4.18.9",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --shims --out-dir lib && koishi-console build .",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "koishi-plugin",
    "ai",
    "image-generation",
    "openai-compatible",
    "openai-official",
    "gemini-official",
    "openai",
    "gemini"
  ]
}
